wsud:AdmissionStep1GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "Applicants submit a completed graduate admission application to the Graduate School via the online application portal." .

wsud:AdmissionStep1NonDegreeStatus a wsu:ProcessStep ;
    rdfs:label "Applicants for non‑degree status must submit a completed graduate application to the Graduate School via the online portal and request an official transcript; licensure applicants follow the same process; transient applicants submit a Permission for Transient Status form; all pay the applicable non‑refundable application fee." .

wsud:AdmissionStep2GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "Applicants request that the registrars of all colleges or universities previously attended send one official transcript directly to the Graduate School." .

wsud:AdmissionStep3GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "A $40 (domestic applicants) or $70 (international applicants) non‑refundable application fee is required. Applicants who are McNair Scholars should submit a Certification of Participation to have the application fee waived." .

wsud:AdmissionStep4GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "If the graduate program requires test scores and/or other supporting materials, applicants must submit appropriate test scores and/or documents such as letters of recommendation, statement of purpose, or statement of goals and objectives." .

wsud:AdmissionStep5GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "The Graduate School reviews the completed admissions file, calculates an applicant's total undergraduate GPA and graduate GPA, then sends copies to the appropriate program for an admission recommendation." .

wsud:AdmissionStep6GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "The program reviews the applicants' academic credentials and sends an admission recommendation to the Graduate School." .

wsud:AdmissionStep7GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "The Associate Director of Graduate Admissions reviews the recommendation and the applicant's academic credentials and determines whether the Graduate School admissions requirements have been met." .

wsud:AdmissionStep8GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "The Graduate School notifies the applicant by letter regarding any decisions about their admission." .

wsud:AdmissionStep9GraduateDegreeStatus a wsu:ProcessStep ;
    rdfs:label "An applicant who does not meet the minimum requirements or has been dismissed may submit a petition for admission per Policy 5080." .

wsud:AdultAndOnlineLearningDivision a wsu:ProvostDivision ;
    rdfs:label "Adult and Online Learning" ;
    wsu:providesFunction "Gateway for academic and holistic success for nontraditional and remote learners." .

