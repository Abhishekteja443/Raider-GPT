:Cohort_WrightGuarantee_2024_25 a wsu:TuitionCohort ;
    rdfs:label "Undergraduate Wright Guarantee 2024–25" .

:Cohort_WrightGuarantee_2025_26 a wsu:TuitionCohort ;
    rdfs:label "Undergraduate Wright Guarantee 2025–26" .

:CostComponent_WG_Housing a wsu:CostComponent ;
    rdfs:label "Campus Housing (Woods Double), Wright Guarantee 2026–27: $2,878 per semester" ;
    rdfs:comment "Double occupancy for a Woods room." .

:CostComponent_WG_Meals a wsu:CostComponent ;
    rdfs:label "Meals (Gold Campus Dining), Wright Guarantee 2026–27: $2,000 per semester" ;
