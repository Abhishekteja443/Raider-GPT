# ==== Graduate admission procedures ====

:Procedure_GraduateDegreeAdmission a wsu:AdmissionProcedure ;
    rdfs:label "Admission Procedure for Graduate Degree Status" ;
    wsu:hasStep :Procedure_GraduateDegreeAdmission_Step1, :Procedure_GraduateDegreeAdmission_Step2, :Procedure_GraduateDegreeAdmission_Step3, :Procedure_GraduateDegreeAdmission_Step4, :Procedure_GraduateDegreeAdmission_Step5, :Procedure_GraduateDegreeAdmission_Step6, :Procedure_GraduateDegreeAdmission_Step7, :Procedure_GraduateDegreeAdmission_Step8, :Procedure_GraduateDegreeAdmission_Step9 .

:Procedure_GraduateDegreeAdmission_Step1 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 1: Submit application" ;
    rdfs:comment "Submit a completed graduate admission application via the online portal. Applications and all supporting credentials should be received at least four weeks before registration for the starting semester; some programs have earlier deadlines." ;
    wsu:precedesStep :Procedure_GraduateDegreeAdmission_Step2 .

:Procedure_GraduateDegreeAdmission_Step2 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 2: Request official transcripts" ;
    rdfs:comment "Request that registrars of all previously attended colleges or universities send one official transcript directly to the Graduate School." ;
    wsu:precedesStep :Procedure_GraduateDegreeAdmission_Step3 .

:Procedure_GraduateDegreeAdmission_Step3 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 3: Pay application fee" ;
    rdfs:comment "Pay a $40 (domestic) or $70 (international) non-refundable application fee; McNair Scholars may have the fee waived with a Certification of Participation." ;
    wsu:precedesStep :Procedure_GraduateDegreeAdmission_Step4 .

:Procedure_GraduateDegreeAdmission_Step4 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 4: Submit test scores and supporting materials" ;
    rdfs:comment "Submit test scores and/or documents such as letters of recommendation or statements of purpose if the program requires them, and meet any additional program requirements." ;
    wsu:precedesStep :Procedure_GraduateDegreeAdmission_Step5 .

:Procedure_GraduateDegreeAdmission_Step5 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 5: Graduate School file review" ;
    rdfs:comment "The Graduate School reviews the file, calculates undergraduate and graduate GPAs, and sends the application to the program for an admission recommendation." ;
    wsu:precedesStep :Procedure_GraduateDegreeAdmission_Step6 .

:Procedure_GraduateDegreeAdmission_Step6 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 6: Program recommendation" ;
    rdfs:comment "The program reviews the applicant's academic credentials and sends an admission recommendation to the Graduate School." ;
    wsu:precedesStep :Procedure_GraduateDegreeAdmission_Step7 .

:Procedure_GraduateDegreeAdmission_Step7 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 7: Associate Director determination" ;
    rdfs:comment "The Associate Director of Graduate Admissions reviews the recommendation and credentials and determines whether Graduate School admission requirements have been met." ;
    wsu:precedesStep :Procedure_GraduateDegreeAdmission_Step8 .

:Procedure_GraduateDegreeAdmission_Step8 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 8: Notification" ;
    rdfs:comment "The Graduate School notifies the applicant by letter of the admission decision." ;
    wsu:precedesStep :Procedure_GraduateDegreeAdmission_Step9 .

:Procedure_GraduateDegreeAdmission_Step9 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Degree Status, step 9: Petition for admission" ;
    rdfs:comment "An applicant who does not meet minimum requirements, or a dismissed student, may petition for admission per Policy 5080." ;
    wsu:governedByPolicy :Policy_5080 .

:Procedure_GraduateNonDegreeAdmission a wsu:AdmissionProcedure ;
    rdfs:label "Admission Procedure for Graduate Non-Degree, Certification, and Transient Statuses" ;
    wsu:hasStep :Procedure_GraduateNonDegreeAdmission_Step1, :Procedure_GraduateNonDegreeAdmission_Step2, :Procedure_GraduateNonDegreeAdmission_Step3, :Procedure_GraduateNonDegreeAdmission_Step4 .

:Procedure_GraduateNonDegreeAdmission_Step1 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Non-Degree, Certification, and Transient Statuses, step 1: Submit application and credentials" ;
    rdfs:comment "Non-degree and licensure applicants submit a graduate application via the online portal and request official transcript(s); transient applicants submit a Permission for Transient Status form in lieu of transcripts." ;
    wsu:precedesStep :Procedure_GraduateNonDegreeAdmission_Step2 .

:Procedure_GraduateNonDegreeAdmission_Step2 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Non-Degree, Certification, and Transient Statuses, step 2: Pay application fee" ;
    rdfs:comment "Non-degree, certificate, and transient applicants pay a $10 (domestic) or $40 (international) non-refundable fee; all other applicants pay $40 (domestic) or $70 (international)." ;
    wsu:precedesStep :Procedure_GraduateNonDegreeAdmission_Step3 .

:Procedure_GraduateNonDegreeAdmission_Step3 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Non-Degree, Certification, and Transient Statuses, step 3: Admission decision" ;
    rdfs:comment "The Associate Director of Graduate Admissions decides non-degree and transient applications; licensure applications are sent to the college for decision." ;
    wsu:precedesStep :Procedure_GraduateNonDegreeAdmission_Step4 .

:Procedure_GraduateNonDegreeAdmission_Step4 a wsu:ProcessStep ;
    rdfs:label "Admission Procedure for Graduate Non-Degree, Certification, and Transient Statuses, step 4: Notification" ;
    rdfs:comment "The Graduate School notifies applicants by letter of the admission decision." .

:Procedure_ChangeOfProgram a wsu:AdmissionProcedure ;
    rdfs:label "Change of Graduate Program Procedure" ;
    wsu:hasStep :Procedure_ChangeOfProgram_Step1, :Procedure_ChangeOfProgram_Step2, :Procedure_ChangeOfProgram_Step3, :Procedure_ChangeOfProgram_Step4 .

:Procedure_ChangeOfProgram_Step1 a wsu:ProcessStep ;
    rdfs:label "Change of Graduate Program Procedure, step 1: Submit application" ;
    rdfs:comment "Submit an application for admission to the new program via the online portal, with any additional admission documents required." ;
    wsu:precedesStep :Procedure_ChangeOfProgram_Step2 .

:Procedure_ChangeOfProgram_Step2 a wsu:ProcessStep ;
    rdfs:label "Change of Graduate Program Procedure, step 2: Program recommendation" ;
    rdfs:comment "The Graduate School forwards the application to the program for an admission recommendation." ;
    wsu:precedesStep :Procedure_ChangeOfProgram_Step3 .

:Procedure_ChangeOfProgram_Step3 a wsu:ProcessStep ;
    rdfs:label "Change of Graduate Program Procedure, step 3: Associate Director review" ;
    rdfs:comment "The Associate Director of Graduate Admissions reviews the recommendation." ;
    wsu:precedesStep :Procedure_ChangeOfProgram_Step4 .

:Procedure_ChangeOfProgram_Step4 a wsu:ProcessStep ;
    rdfs:label "Change of Graduate Program Procedure, step 4: Notification" ;
    rdfs:comment "The Graduate School notifies the student of the admission decision." .


# ==== Graduate petition process steps ====

:GraduatePetitionProcess_Step1 a wsu:ProcessStep ;
    rdfs:label "Graduate petition process, step 1: Graduate School intake review" ;
    rdfs:comment "The Graduate School records petitions and reviews them for clarity and eligibility; unclear petitions are returned and petitions inconsistent with accreditation or external regulations are rejected." ;
    wsu:precedesStep :GraduatePetitionProcess_Step2 .

:GraduatePetitionProcess_Step2 a wsu:ProcessStep ;
    rdfs:label "Graduate petition process, step 2: Program recommendation" ;
    rdfs:comment "Program chairs/advisors review petitions, make recommendations, and forward them to the college/school petitions committee." ;
    wsu:precedesStep :GraduatePetitionProcess_Step3 .

:GraduatePetitionProcess_Step3 a wsu:ProcessStep ;
    rdfs:label "Graduate petition process, step 3: Dean's review" ;
    rdfs:comment "Petitions return to the Graduate School for the dean's review; unresolved differences are referred to the Graduate Student Affairs Committee." ;
    wsu:precedesStep :GraduatePetitionProcess_Step4 .

:GraduatePetitionProcess_Step4 a wsu:ProcessStep ;
    rdfs:label "Graduate petition process, step 4: Written notification" ;
    rdfs:comment "The Graduate School sends written notification of the final decision to the student within ten days of the decision." ;
    wsu:precedesStep :GraduatePetitionProcess_Step5 .

:GraduatePetitionProcess_Step5 a wsu:ProcessStep ;
    rdfs:label "Graduate petition process, step 5: Registrar recording" ;
    rdfs:comment "The Graduate School advises the Office of the Registrar of approved actions, which the Registrar records on the student's academic record." .


# ==== Graduate degree requirements ====

:Requirement_ProgramOfStudy a wsu:DegreeRequirement ;
    rdfs:label "Approved program of study on file" ;
    rdfs:comment "Have a current and approved program of study on file in the Graduate School and/or a current degree audit in uAchieve." ;
    wsu:governedByPolicy :Policy_5470 .

:Requirement_MastersTimeLimit a wsu:DegreeRequirement ;
    rdfs:label "Master's degree time limit" ;
    rdfs:comment "Complete master's program requirements within seven calendar years." ;
    wsu:governedByPolicy :Policy_5520 .

:Requirement_DoctoralTimeLimit a wsu:DegreeRequirement ;
    rdfs:label "Doctoral degree time limit" ;
    rdfs:comment "Complete doctoral program requirements within ten years (Policy 5720.3)." ;
    wsu:governedByPolicy :Policy_5720 .

:Requirement_CertificateTimeLimit a wsu:DegreeRequirement ;
    rdfs:label "Graduate certificate time limit" ;
    rdfs:comment "Complete graduate certificate requirements within five years (Policy 5810.2)." ;
    wsu:governedByPolicy :Policy_5810 .

:Requirement_MinimumGPA a wsu:DegreeRequirement ;
    rdfs:label "Minimum cumulative GPA of 3.0" ;
    rdfs:comment "Achieve a cumulative GPA of at least 3.0 in all courses taken for graduate credit; no more than six semester hours of 'C' may be applied to degree requirements (Policy 5370.1)." ;
    wsu:governedByPolicy :Policy_5370 .

:Requirement_DefenseTermRegistration a wsu:DegreeRequirement ;
    rdfs:label "Registration during thesis/dissertation defense term" ;
    rdfs:comment "Register for at least one graduate credit hour during the term in which a thesis/dissertation is defended." ;
    wsu:governedByPolicy :Policy_5270 .

:Requirement_ComprehensiveExam a wsu:DegreeRequirement ;
    rdfs:label "Final comprehensive examination (if required)" ;
    rdfs:comment "Complete a final comprehensive examination if required by the program." .

:Requirement_ApprovedThesis a wsu:DegreeRequirement ;
    rdfs:label "Approved thesis/dissertation (if required)" ;
    rdfs:comment "Present one copy of an approved thesis/dissertation for approval of the dean of the Graduate School and submission to OhioLINK (Policy 5515.1.9)." ;
    wsu:governedByPolicy :Policy_5515 .

:Requirement_ResidenceCredit a wsu:DegreeRequirement ;
    rdfs:label "At least 50 percent of credit hours at Wright State" ;
    rdfs:comment "Complete at least 50 percent of the credit hours at Wright State." ;
    wsu:governedByPolicy :Policy_5380 .

:Requirement_ForeignLanguage a wsu:DegreeRequirement ;
    rdfs:label "Foreign language reading knowledge (if required)" ;
    rdfs:comment "A master's candidate may be required to demonstrate reading knowledge of a foreign language, by examination or college credit, depending on the program." .


# ==== Academic milestones ====

:Milestone_GraduationApplication a wsu:AcademicMilestone ;
    rdfs:label "Graduation Application" ;
    wsu:milestoneType "GraduationApplication" ;
    wsu:hasFee "35.00"^^xsd:decimal ;
    rdfs:comment "Submitted online only through WINGS Express; the $35 fee applies each time an application is submitted, and a separate application is required for each degree." .

:Milestone_GraduateAcademicPetition a wsu:AcademicMilestone ;
    rdfs:label "Graduate Academic Petition" ;
    wsu:milestoneType "Petition" ;
    rdfs:comment "Petition to the Graduate School requesting a waiver of a policy governing graduate students; should include the program advisor's recommendation (and the instructor's for course-related petitions). Results may not be further appealed." .

:Milestone_GraduateAdmissionPetition a wsu:AcademicMilestone ;
    rdfs:label "Graduate Admission Petition" ;
    wsu:milestoneType "Petition" ;
    wsu:governedByPolicy :Policy_5080 .

:Milestone_GraduateReadmissionPetition a wsu:AcademicMilestone ;
    rdfs:label "Graduate Re-admission Petition" ;
    wsu:milestoneType "Petition" ;
    wsu:governedByPolicy :Policy_5080 ;
    rdfs:comment "Only for use by those who have been academically dismissed." .

:Milestone_AdministrativeAdjustmentPetition a wsu:AcademicMilestone ;
    rdfs:label "Administrative Adjustment Petition" ;
    wsu:milestoneType "Petition" ;
    wsu:requiresApprovalFrom :OfficeOfTheRegistrar ;
    rdfs:comment "Petitions involving university or administrative errors or requiring a retroactive administrative drop for verified non-attendance, which the University Registrar may approve." .

:Milestone_ThesisOrDissertation a wsu:AcademicMilestone ;
    rdfs:label "Thesis or Dissertation" ;
    wsu:milestoneType "ThesisOrDissertation" ;
    wsu:governedByPolicy :Policy_5515 .

:Milestone_ComprehensiveExamination a wsu:AcademicMilestone ;
    rdfs:label "Comprehensive Examination" ;
    wsu:milestoneType "ComprehensiveExam" ;
    rdfs:comment "Required by some programs; may be written, oral, or both. Arrangements should be made at least three weeks before the examination date." .