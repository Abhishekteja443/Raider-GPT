@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix wsu:  <https://example.org/wsu-ontology#> .
@prefix :     <https://example.org/wsu-data/> .

# Instance data for the Wright State University Ontology (https://example.org/wsu-ontology).
# Schema terms (wsu:) are reused unchanged; instances use the default (:) namespace.
# Facts are drawn from the combined wright.edu source pages (_combined.md).

<https://example.org/wsu-data> a owl:Ontology ;
    rdfs:label "Wright State University knowledge graph" ;
    owl:imports <https://example.org/wsu-ontology> .


# ==== University ====

:WSU a wsu:University ;
    rdfs:label "Wright State University" ;
    rdfs:comment "National public university in Dayton, Ohio, named for aviation pioneers Orville and Wilbur Wright. Source states 'more than 11,000 students' (not an exact enrollment count)." ;
    wsu:numPrograms "315"^^xsd:integer ;
    wsu:numColleges "6"^^xsd:integer ;
    wsu:partneredWith :PremierHealth ;
    wsu:receivedRecognition :Recognition_CWURGlobal2000_2026 .

:PremierHealth a wsu:Organization ;
    rdfs:label "Premier Health" ;
    rdfs:comment "Health system with a longstanding working relationship with Wright State to advance academic medicine, community health, and workforce development." .


# ==== Colleges, schools, and branch campus ====

:RSCOB a wsu:College ;
    rdfs:label "Raj Soin College of Business" ;
    wsu:isPartOf :WSU ;
    wsu:locatedIn :Loc_100RikeHall ;
    wsu:hasContact :Contact_RSCOB ;
    wsu:hasSocialMedia :RSCOB_Facebook, :RSCOB_Instagram, :RSCOB_LinkedIn ;
    rdfs:comment "Offers bachelor's and master's degrees, certificates, and continuing education; curriculum emphasizes real-world experiences and entrepreneurship." ;
    wsu:accreditedBy :AACSBAccreditation ;
    wsu:receivedRecognition :Recognition_PrincetonReviewBestBusinessSchool, :Recognition_USNewsBestOnlineBusinessProgramMasters .

:CECS a wsu:College ;
    rdfs:label "College of Engineering and Computer Science" ;
    wsu:isPartOf :WSU ;
    wsu:locatedIn :Loc_405RussEngineeringCenter ;
    wsu:hasContact :Contact_CECS ;
    wsu:hasSocialMedia :CECS_Facebook, :CECS_Instagram, :CECS_LinkedIn ;
    rdfs:comment "Offers bachelor's, master's, and doctoral degrees and undergraduate and graduate certificates; many bachelor's programs have a 4+1 bachelor's/master's option." .

:GraduateSchool a wsu:School ;
    rdfs:label "School of Graduate Studies" ;
    wsu:isPartOf :WSU ;
    wsu:locatedIn :Loc_350UniversityHall ;
    wsu:hasContact :Contact_GraduateSchool ;
    rdfs:comment "Also referred to as the Graduate School. Offers graduate assistantships and fellowships." .

:CHEHS a wsu:College ;
    rdfs:label "College of Health, Education, and Human Services" ;
    wsu:isPartOf :WSU ;
    wsu:locatedIn :Loc_163MillettHall ;
    wsu:hasContact :Contact_CHEHS ;
    wsu:hasSocialMedia :CHEHS_Facebook, :CHEHS_Instagram ;
    rdfs:comment "Launched in Fall Semester 2021; programs organized into four schools." .

:LakeCampus a wsu:BranchCampus ;
    rdfs:label "Lake Campus" ;
    wsu:isPartOf :WSU ;
    wsu:locatedIn :Loc_7600LakeCampusDriveCelinaOH45822 ;
    wsu:hasContact :Contact_LakeCampus ;
    wsu:hasSocialMedia :LakeCampus_Facebook, :LakeCampus_Instagram, :LakeCampus_LinkedIn, :LakeCampus_X ;
    rdfs:comment "173-acre campus on the shore of Grand Lake St. Marys, a 90-minute drive from the Dayton campus. The Western Ohio College in Celina became a Wright State branch campus in 1969; it now has four buildings." .

:CoLA a wsu:College ;
    rdfs:label "College of Liberal Arts" ;
    wsu:isPartOf :WSU ;
    wsu:locatedIn :Loc_114AllynHall ;
    wsu:hasContact :Contact_CoLA ;
    wsu:hasSocialMedia :CoLA_Facebook, :CoLA_Instagram, :CoLA_LinkedIn, :CoLA_Snapchat, :CoLA_X ;
    rdfs:comment "Offers bachelor's and master's degrees and undergraduate and graduate certificates in the social sciences, humanities, fine and performing arts, and interdisciplinary programs." .

:BSOM a wsu:School ;
    rdfs:label "Boonshoft School of Medicine" ;
    wsu:isPartOf :WSU ;
    wsu:locatedIn :Loc_290WhiteHall ;
    wsu:hasContact :Contact_BSOM ;
    wsu:hasSocialMedia :BSOM_Facebook, :BSOM_Instagram, :BSOM_LinkedIn, :BSOM_X, :BSOM_YouTube ;
    rdfs:comment "Medical school offering education leading to the M.D., M.D./Ph.D., M.D./M.B.A., or M.D./M.P.H. degree, residency and fellowship training, and master's programs; affiliated with major teaching hospitals in the greater Dayton area." ;
    wsu:offersCredential :Degree_MedicineMD, :Degree_MedicineAndPhilosophyMDPhD, :Degree_MedicineAndBusinessAdministrationMDMBA, :Degree_MedicineAndPublicHealthMDMPH .

:CoSM a wsu:College ;
    rdfs:label "College of Science and Mathematics" ;
    wsu:isPartOf :WSU ;
    wsu:locatedIn :Loc_134OelmanHall ;
    wsu:hasContact :Contact_CoSM ;
    wsu:hasSocialMedia :CoSM_Facebook, :CoSM_Instagram, :CoSM_LinkedIn ;
    rdfs:comment "Offers bachelor's, master's, and doctoral programs and undergraduate and graduate certificates; largest departments are biological sciences and psychology." ;
    wsu:offersCredential :Degree_AnatomyMS, :Degree_BiochemistryAndMolecularBiologyMS, :Degree_MicrobiologyAndImmunologyMS, :Degree_PhysiologyAndNeuroscienceMS, :Degree_BiomedicalSciencesPhD, :Degree_EnvironmentalSciencesPhD, :Degree_HumanFactorsIndustrialPsychologyPhD, :Degree_InterdisciplinaryAppliedScienceAndMathematicsPhD .


