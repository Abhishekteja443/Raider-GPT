# ==== Leadership, divisions, and people ====

:Provost a wsu:LeadershipRole ;
    rdfs:label "Provost" ;
    wsu:hasScope "Chief academic officer of the university, responsible for academic affairs across the Dayton, Lake, and online campuses and programs; collaborates with the president and other stakeholders in setting overall academic priorities and strategies." ;
    wsu:hasDivision :Division_AcademicAffairs, :Division_AdultAndOnlineLearning, :Division_AccreditationAndAssessment, :Division_FacultyAffairs, :Division_CurricularAndStrategicInitiatives, :Division_ResearchAndInnovation ;
    wsu:oversees :RSCOB, :CECS, :GraduateSchool, :CHEHS, :LakeCampus, :CoLA, :BSOM, :CoSM .

:Division_AcademicAffairs a wsu:ProvostDivision ;
    rdfs:label "Academic Affairs" ;
    wsu:providesFunction "Resources that enhance, empower, and support success in the classroom, including honors, and other educational programs." .

:Division_AdultAndOnlineLearning a wsu:ProvostDivision ;
    rdfs:label "Adult and Online Learning" ;
    wsu:providesFunction "Gateway for academic and holistic success for nontraditional and remote learners." .

:Division_AccreditationAndAssessment a wsu:ProvostDivision ;
    rdfs:label "Accreditation and Assessment" ;
    wsu:providesFunction "Resources for accreditation, academic program review, and student learning outcomes." .

:Division_FacultyAffairs a wsu:ProvostDivision ;
    rdfs:label "Faculty Affairs" ;
    wsu:providesFunction "Home to the Center for Faculty Excellence, as well as faculty-specific documents, policies, forms, and other resources." .

:Division_CurricularAndStrategicInitiatives a wsu:ProvostDivision ;
    rdfs:label "Curricular and Strategic Initiatives" ;
    wsu:providesFunction "Resources relating to the curriculum, as well as current projects underway to achieve and advance the university's mission." .

:Division_ResearchAndInnovation a wsu:ProvostDivision ;
    rdfs:label "Research and Innovation" ;
    wsu:providesFunction "Resources and tools for the advancement of research and scholarly activities, as well as their compliance and the development of innovations." .

:InterimDeanRajSoinCollegeOfBusiness a wsu:LeadershipRole ;
    rdfs:label "Interim Dean, Raj Soin College of Business" ;
    wsu:oversees :RSCOB .

:UniversityLibrarian a wsu:LeadershipRole ;
    rdfs:label "University Librarian" .

:DonaldHopkins a wsu:Person ;
    rdfs:label "Donald Hopkins" ;
