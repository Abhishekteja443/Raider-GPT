:WrightGuaranteeTuitionProgram a wsu:TuitionProgram ;
    rdfs:label "Wright Guarantee Tuition Program" ;
    rdfs:comment "Guarantees the same annual cost of in-state tuition, housing rates, and meal plans over a four-year college career for new incoming, degree-seeking undergraduate students; available for both the Dayton and Lake campuses. Out-of-state tuition for non-Ohio residents is not guaranteed." .


# ==== Tuition: residency, levels, cohorts, cost components ====

:OhioResidentCommuting a wsu:ResidencyStatus ;
    rdfs:label "Ohio Resident (Commuting)" .

:OhioResidentLivingOnCampus a wsu:ResidencyStatus ;
    rdfs:label "Ohio Resident (Living on Campus)" .

:OhioResident a wsu:ResidencyStatus ;
    rdfs:label "Ohio Resident" .

:NonOhioResident a wsu:ResidencyStatus ;
    rdfs:label "Non-Ohio Resident" .

:Level_Undergraduate a wsu:AcademicLevel ;
    rdfs:label "Undergraduate" .

:Level_Graduate a wsu:AcademicLevel ;
    rdfs:label "Graduate" .

:Level_Professional a wsu:AcademicLevel ;
    rdfs:label "Professional" .

:Cohort_WrightGuarantee_2026_27 a wsu:TuitionCohort ;
    rdfs:label "Undergraduate Wright Guarantee 2026–27" ;
    rdfs:comment "New incoming, degree-seeking undergraduate students starting in Fall 2026 or Spring 2027. Flat tuition covers 11–18 hours per semester; the per-hour rate applies to 1–10.5 hours and to each billable credit hour in excess of 18. Costs do not include course or program fees." .

:Cohort_UndergraduateNonGuarantee_2026_27 a wsu:TuitionCohort ;
    rdfs:label "Undergraduate Non-Guarantee 2026–27" ;
    rdfs:comment "Flat tuition covers 11–18 hours per semester; the per-hour rate applies to 1–10.5 hours and to each billable credit hour in excess of 18. Costs do not include course or program fees." .

:Cohort_GraduateAndProfessional_2026_27 a wsu:TuitionCohort ;
    rdfs:label "Graduate and Professional 2026–27" ;
    rdfs:comment "Rates determined annually by the Wright State University Board of Trustees. Flat rates cover 11–18 hours per semester unless the rate label says '11 or more hours'; per-hour rates apply to 1–10.5 hours and, for 11–18-hour rates, to each billable credit hour in excess of 18." .

